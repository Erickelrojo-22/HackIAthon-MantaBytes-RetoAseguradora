# Optional OpenAI mode. If these are empty, FraudIA runs fully offline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional override for local data path.
FRAUDIA_DB_BACKEND=sqlite
FRAUDIA_DB_PATH=data/processed/fraudia_claims.db
FRAUDIA_DATABASE_URL=

# Data source: demo | csv | company_synthetic
FRAUDIA_DATA_SOURCE=demo
FRAUDIA_COMPANY_DATA_DIR=data/company_synthetic

# Comma-separated browser origins allowed by CORS (defaults to local Vite ports).
FRAUDIA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Upload / abuse controls
FRAUDIA_MAX_CSV_BYTES=2097152
FRAUDIA_RATE_LIMIT_WINDOW=60
FRAUDIA_RATE_LIMIT_MAX=60

# Demo auth overrides. Los valores por defecto son publicos (viven en el codigo abierto);
# sobrescribelos en cualquier despliegue expuesto a internet.
FRAUDIA_DEMO_PASSWORD=
FRAUDIA_TOKEN_ANALISTA=
FRAUDIA_TOKEN_JEFATURA=
FRAUDIA_TOKEN_AUDITORIA=
